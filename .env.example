APP_NAME=VibeWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=websidebuilder
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI website generation (config/ai.php) ---
# Provider: auto (default) picks by key prefix — `sk-…` = OpenAI, `pk_live_…` = Puku (puku.sh).
# Either paste one key into AI_API_KEY, or set OPENAI_API_KEY / PUKU_API_KEY and (optionally) AI_PROVIDER.
# Check what's resolved with: php artisan ai:doctor
# AI_PROVIDER=auto
# AI_API_KEY=
# OPENAI_API_KEY=
# PUKU_API_KEY=
# PUKU_BASE_URL=https://api-cli.puku.sh
# PUKU_GENERATE_MODEL=opus
# PUKU_EDIT_MODEL=puku-ai-2.8
# OPENAI_REQUEST_TIMEOUT=150
# AI_GENERATE_MODEL=gpt-4.1
# AI_EDIT_MODEL=gpt-4.1-mini
# AI_GENERATE_TEMPERATURE=0.8
# AI_EDIT_TEMPERATURE=0.3
# AI_RETRIES=1
# --- Stock photos ---
# The 2,700+ photo catalog ships with the project (database/seeders/data/stock_photos.json.gz):
#   php artisan db:seed --class=StockPhotoSeeder
# It was built without any API key from the Unsplash Lite dataset (https://unsplash.com/data):
#   php artisan photos:import-dataset /path/to/unzipped-dataset && php artisan photos:analyze && php artisan photos:export
# Optional live sources for photos:import (if you have a key): PEXELS_API_KEY / UNSPLASH_ACCESS_KEY.
# PEXELS_API_KEY=
# AI_PHOTO_ANALYZE_PROVIDER=openai     # vision model provider for photos:analyze
# AI_PHOTO_ANALYZE_MODEL=gpt-4.1-mini
# AI_PHOTO_RERANK=true                 # AI picks the hero photo among the best candidates
# Optional: live Unsplash search in the picker (free key at https://unsplash.com/developers).
# UNSPLASH_ACCESS_KEY=
